# Quiet boot for phones with autologin UIs: keep the firmware splash on the panel
# (no framebuffer clear at video probe) and route the console to serial only; the
# boot menu re-enables the video console (see qcom-phone-quiet.env).
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/qcom-phone-quiet.env"
CONFIG_NO_FB_CLEAR=y
# Options the phone's original build had that qcom_defconfig lacks (found by diffing the
# binaries' strings): blkmap is what preboot uses to expose the ESP inside the Nura image.
CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
CONFIG_CMD_UFETCH=y
CONFIG_IPV6=y
